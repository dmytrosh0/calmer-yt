{
  "manifest_version": 3,
  "name": "Calmer YT",
  "version": "1.3.0",
  "description": "Personal YouTube cleanup: subscriptions instead of home, no Shorts, no hover previews, calmer layout.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "css": [
        "css/home-redirect.css",
        "css/shorts.css",
        "css/hover-preview.css",
        "css/thumbnails.css",
        "css/related.css",
        "css/layout.css"
      ],
      "js": [
        "features.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Calmer YT",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
